{
  "name": "excalibur-game",
  "productName": "excalibur-game",
  "version": "1.0.0",
  "description": "My Excalibur Electron application description",
  "main": "src/electron-main.js",
  "license": "BSD-2-Clause",
  "author": {
    "name": "Excalibur.js Team",
    "url": "https://github.com/excaliburjs"
  },
  "targets": {
    "main": false
  },
  "scripts": {
    "build-game": "parcel build ./src/index.html --dist-dir ./dist --public-url ./",
    "start": "npm run build-game && electron-forge start",
    "build": "npm run build-game && electron-forge make",
    "build:ci": "npm run build-game && electron-forge make",
    "test:update-snapshot": "npm run build-game && playwright test --update-snapshots=all",
    "test": "npm run build && playwright test",
    "test:ci": "npm run build:ci && playwright test",
    "package": "npm run build-game && electron-forge package",
    "make": "npm run build-game && electron-forge make",
    "typecheck": "tsc --noEmit -p src/tsconfig.json"
  },
  "keywords": [
    "electron-app",
    "electron"
  ],
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "excalibur": "^1.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@playwright/test": "1.65.0",
    "electron": "45.3.0",
    "parcel": "2.16.4",
    "typescript": "7.0.2"
  }
}
